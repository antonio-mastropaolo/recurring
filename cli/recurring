def cmd_add(args, raw, services):
    taken = {s["id"] for s in services}
    if args.cadence == "term" and not (args.start and args.end):
        sys.exit("--cadence term needs --start and --end")
    if args.cadence == "annual" and args.month is None and args.day is not None:
        sys.exit("--cadence annual needs --month too")
    for v, flag in ((args.start, "--start"), (args.end, "--end")):
        if v:
            check_date(v, flag)
    kind = args.kind or ("unknown" if args.amount is None else "usage" if args.cadence == "usage" else "fixed")
    entry = {
        "id": slug(args.name, taken), "name": args.name, "category": args.category,
        "amount": args.amount, "amount_kind": kind, "cadence": args.cadence,
        "billing_day": args.day, "billing_month": args.month, "plan": args.plan,
        "note": args.note, "check": args.check, "account": args.account, "card": args.card,
        "manage_url": args.url, "status": "active", "term_start": args.start, "term_end": args.end,
    }
    raw["services"].append({k: v for k, v in entry.items() if v is not None})
    save(raw)
    print(f"added {entry['id']}")


def cmd_charge(args, raw, services):
    s = find_exact(services, args.id)
    o = s["_raw"]
    d = check_date(args.date, "--date") if args.date else today().isoformat()
    if not args.force and any(c["date"] == d and abs(c["amount"] - args.amount) < 0.005 for c in s["charges"]):
        sys.exit(f"{s['id']} already has a {money(args.amount)} charge on {d} (use --force to add another)")
    if "charges" in o and o["charges"] is not None and not isinstance(o["charges"], list):
        sys.exit(f"{s['id']}: charges in the file is not a list — fix it by hand first (nothing was changed)")
    c = {"date": d, "amount": args.amount}
    if args.note:
        c["note"] = args.note
    charges = o.get("charges") or []
    charges.append(c)
    charges.sort(key=lambda c: c.get("date", "") if isinstance(c, dict) else "")
    o["charges"] = charges
    if args.amount > 0 and (not s["last_charged"] or d >= s["last_charged"]):
        # A plan billed on the 31st lands on Feb 28; without a billing_day the
        # schedule follows last_charged, so pin the real day before moving it.
        old, new = parse_day(s["last_charged"]), parse_day(d)
        if (s["cadence"] in ("monthly", "usage") and s["billing_day"] is None and old and old.day > new.day
                and new.day == calendar.monthrange(new.year, new.month)[1]):
            o["billing_day"] = old.day
        o["last_charged"] = d
        if not args.keep_amount:
            o["amount"] = args.amount
            if o.get("amount_kind") in (None, "unknown"):
                o["amount_kind"] = "usage" if s["cadence"] == "usage" else "fixed"
    save(raw)
    print(f"{s['id']}: recorded {money(args.amount)} on {d}")


def cmd_closing(args, raw, services):
    s = find_exact(services, args.id)
    if s["status"] != "active":
        sys.exit(f"{s['id']} is {s['status']}, not active")
    if getattr(args, "clear", False):
        s["_raw"].pop("cancel_requested", None)
        save(raw)
        print(f"{s['id']}: active (closing cleared)")
        return
    s["_raw"]["cancel_requested"] = today().isoformat()
    if args.note:
        s["_raw"]["note"] = args.note
    save(raw)
    print(f"{s['id']}: closing since {s['_raw']['cancel_requested']}")


def set_status(raw, services, ident, cancelled: bool, ends: str | None = None):
    """Same transition as Store.setStatus in the app."""
    s = find_exact(services, ident)
    o = s["_raw"]
    o.pop("cancel_requested", None)
    if cancelled:
        o["status"] = "cancelled"
        o["cancelled_on"] = today().isoformat()
        if ends:
            o["ends_on"] = check_date(ends, "--ends")
    else:
        o["status"] = "active"
        o.pop("cancelled_on", None)
        o.pop("ends_on", None)
    save(raw)
    print(f"{s['id']}: {o['status']}")


def cmd_set(args, raw, services):
    s = find_exact(services, args.id)
    o = s["_raw"]
    for pair in args.pairs:
        if "=" not in pair:
            sys.exit(f"expected field=value, got '{pair}'")
        key, val = pair.split("=", 1)
        if key not in STR_FIELDS and key not in INT_FIELDS and key not in FLOAT_FIELDS:
            sys.exit(f"unknown field '{key}'")
        if val == "":
            o.pop(key, None)
            continue
        if key in INT_FIELDS:
            lo, hi = INT_FIELDS[key]
            try:
                n = int(val)
            except ValueError:
                sys.exit(f"{key} must be a whole number")
            if not lo <= n <= hi:
                sys.exit(f"{key} must be {lo}-{hi}")
            o[key] = n
        elif key in FLOAT_FIELDS:
            try:
                o[key] = finite_float(val)
            except argparse.ArgumentTypeError as e:
                sys.exit(f"{key}: {e}")
        else:
            if key == "amount_kind" and val not in KINDS:
                sys.exit(f"amount_kind must be one of {KINDS}")
            if key == "cadence" and val not in CADENCES:
                sys.exit(f"cadence must be one of {CADENCES}")
            if key == "status" and val not in STATUSES:
                sys.exit(f"status must be one of {STATUSES}")
            if key in DATE_FIELDS:
                check_date(val, key)
            o[key] = val
    save(raw)
    print(f"updated {s['id']}")


def cmd_refund(args, raw, services):
    s = find_exact(services, args.id)
    o = s["_raw"]
    claims = o.get("refunds")
    if claims is not None and not isinstance(claims, list):
        sys.exit(f"{s['id']}: refunds in the file is not a list — fix it by hand first (nothing was changed)")
    claims = claims or []
    if args.amount is not None:
        if args.amount <= 0:
            sys.exit("refund amount must be positive")
        c = {"amount": args.amount, "status": args.status or "open", "opened": today().isoformat()}
        if args.note:
            c["note"] = args.note
        claims.append(c)
        o["refunds"] = claims
        save(raw)
        print(f"{s['id']}: chasing {money(args.amount)} ({c['status']})")
        return
    if not args.status:
        sys.exit("give an AMOUNT to start a claim, or --status to update the latest pending one")
    pending = [c for c in claims if isinstance(c, dict) and c.get("status", "open") in ("open", "requested")]
    if not pending:
        sys.exit(f"{s['id']} has no pending refund claim")
    c = pending[-1]
    c["status"] = args.status
    if args.status in ("won", "lost"):
        c["resolved"] = today().isoformat()
    if args.note:
        c["note"] = args.note
    save(raw)
    print(f"{s['id']}: refund {money(num(c.get('amount')))} → {args.status}")


def cmd_remove(args, raw, services):
    s = find_exact(services, args.id)
    raw["services"] = [o for o in raw["services"] if o is not s["_raw"]]
    save(raw)
    print(f"removed {s['id']} (previous file kept as {canonical_path().name}.bak)")


def _ensure_crypto_python(need_pdf: bool = False) -> None:
    try:
        import cryptography  # noqa: F401
        if need_pdf:
            import pypdf  # noqa: F401
        return
    except ImportError:
        brew_py = "/opt/homebrew/bin/python3"
        if os.path.exists(brew_py) and os.path.realpath(sys.executable) != os.path.realpath(brew_py):
            os.execv(brew_py, [brew_py, *sys.argv])
        raise


def _cli_dir() -> str:
    return str(Path(__file__).resolve().parent)


def main(argv=None):
    if _cli_dir() not in sys.path:
        sys.path.insert(0, _cli_dir())

    argv_list = list(sys.argv[1:] if argv is None else argv)
    if argv_list and argv_list[0] in ("sync", "vault"):
        _ensure_crypto_python()
    elif argv_list and argv_list[0] in ("wm-cloud", "reimburse"):
        if argv is None:
            _ensure_crypto_python(need_pdf=True)
        import recurring_reimburse
        rc = recurring_reimburse.main(argv_list[1:])
        if rc != 0:
            raise SystemExit(rc)
        return

    p = argparse.ArgumentParser(prog="recurring", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd")
    pl = sub.add_parser("list"); pl.add_argument("--all", action="store_true"); pl.add_argument("--json", action="store_true")
    sub.add_parser("total")
    sub.add_parser("needs")
    pr = sub.add_parser("report"); pr.add_argument("--back", type=int, default=4); pr.add_argument("--ahead", type=int, default=11); pr.add_argument("--json", action="store_true")
    pu = sub.add_parser("upcoming"); pu.add_argument("--days", type=int, default=7)
    pa = sub.add_parser("add")
    pa.add_argument("name")
    pa.add_argument("--amount", type=finite_float)
    pa.add_argument("--day", type=day_of_month)
    pa.add_argument("--month", type=month_of_year)
    pa.add_argument("--start"); pa.add_argument("--end")
    pa.add_argument("--category", default="Other")
    pa.add_argument("--kind", choices=KINDS)
    pa.add_argument("--cadence", choices=CADENCES, default="monthly")
    for f in ("--plan", "--note", "--check", "--account", "--card", "--url"):
        pa.add_argument(f)
    pc = sub.add_parser("charge")
    pc.add_argument("id"); pc.add_argument("amount", type=finite_float)
    pc.add_argument("--date"); pc.add_argument("--note"); pc.add_argument("--keep-amount", action="store_true")
    pc.add_argument("--force", action="store_true")
    pcl = sub.add_parser("closing"); pcl.add_argument("id"); pcl.add_argument("--note"); pcl.add_argument("--clear", action="store_true")
    pcan = sub.add_parser("cancel"); pcan.add_argument("id"); pcan.add_argument("--ends")
    for name in ("reactivate", "remove"):
        sub.add_parser(name).add_argument("id")
    ps = sub.add_parser("set"); ps.add_argument("id"); ps.add_argument("pairs", nargs="+")
    sub.add_parser("path")
    prn = sub.add_parser("renewals"); prn.add_argument("--days", type=int, default=30); prn.add_argument("--min", type=float, default=0)
    sub.add_parser("watch")
    psv = sub.add_parser("savings"); psv.add_argument("--days", type=int, default=30)
    sub.add_parser("cut")
    prf = sub.add_parser("refund")
    prf.add_argument("id"); prf.add_argument("amount", nargs="?", type=finite_float)
    prf.add_argument("--status", choices=REFUND_STATUSES); prf.add_argument("--note")

    # Sync, Vault & Reimburse subcommands
    sub.add_parser("reimburse", help="Deterministic cloud/API receipt packet builder & verifier")
    sub.add_parser("wm-cloud", help="Alias for `recurring reimburse` packet builder")
    try:
        import recurring_sync
        import recurring_vault
        recurring_sync.build_sync_subparser(sub)
        recurring_vault.build_vault_subparser(sub)
    except ImportError:
        pass

    args = p.parse_args(argv)
    if args.cmd == "path":
        print(ledger_path())
        return
    if args.cmd == "sync":
        import recurring_sync
        recurring_sync.dispatch_sync(args)
        return
    if args.cmd == "vault":
        import recurring_vault
        try:
            recurring_vault.dispatch_vault(args)
        except (ValueError, PermissionError, FileNotFoundError) as exc:
            sys.exit(str(exc))
        return
    if os.environ.get("RECURRING_FILE"):
        print(f"(using RECURRING_FILE={ledger_path()})", file=sys.stderr)
    if args.cmd in ("add", "charge", "closing", "cancel", "reactivate", "set", "remove", "refund"):
        with locked():
            raw = load_raw()
            if "services" not in raw:
                raw["services"] = []
            if not isinstance(raw["services"], list):
                sys.exit(f"{ledger_path()}: services is not a list — fix it by hand first (nothing was changed)")
            services, _ = normalize(raw)
            if args.cmd == "add":
                cmd_add(args, raw, services)
            elif args.cmd == "charge":
                cmd_charge(args, raw, services)
            elif args.cmd == "closing":
                cmd_closing(args, raw, services)
            elif args.cmd == "cancel":
                set_status(raw, services, args.id, True, args.ends)
            elif args.cmd == "reactivate":
                set_status(raw, services, args.id, False)
            elif args.cmd == "set":
                cmd_set(args, raw, services)
            elif args.cmd == "remove":
                cmd_remove(args, raw, services)
            elif args.cmd == "refund":
                cmd_refund(args, raw, services)
        return
    services, issues = normalize(load_raw())
    if args.cmd in (None, "list"):
        if args.cmd is None:
            args.all, args.json = False, False
        cmd_list(args, services, issues)
    elif args.cmd == "total":
        cmd_total(args, services, issues)
    elif args.cmd == "needs":
        cmd_needs(args, services, issues)
    elif args.cmd == "report":
        cmd_report(args, services, issues)
    elif args.cmd == "upcoming":
        cmd_upcoming(args, services, issues)
    elif args.cmd == "renewals":
        cmd_renewals(args, services, issues)
    elif args.cmd == "watch":
        cmd_watch(args, services, issues)
    elif args.cmd == "savings":
        cmd_savings(args, services, issues)
    elif args.cmd == "cut":
        cmd_cut(args, services, issues)


if __name__ == "__main__":
    main()
