#!/usr/bin/env python3
"""recurring — headless view/editor for the Recurring menu-bar app's list.

The list lives at ~/.recurring/subscriptions.json (override with RECURRING_FILE).
The menu-bar app watches ~/.recurring via kernel VNODE events, updating live (<80 ms).

  recurring                       active items grouped by category + totals
  recurring list --all            include unverified and ended items
  recurring report [--back 4 --ahead 11] [--json]
                                  cadence mix, per category, per account, per card,
                                  cash out by month (charged vs scheduled), prepaid windows
  recurring upcoming [--days 7]   charges, prepaid expiries and wind-downs ahead
  recurring needs                 closing, to-check and unverified items, plus file problems
  recurring renewals [--days 30] [--min 0]   charges ahead with the last day to cancel
  recurring watch                 money back: refunds being chased, charges after a cancel, cancels to watch
  recurring refund ID AMOUNT [--note ...] [--status open|requested|won|lost]   start chasing a refund
  recurring refund ID --status requested|won|lost   update the latest pending claim
  recurring savings [--days 30]   what cancellations removed per month, and what they've kept so far
  recurring cut                   overlapping plans grouped, with what keeping one would save
  recurring total                 monthly run-rate (prepaid terms averaged) + yearly
  recurring add NAME --amount 12.99 --day 14 [--category ...] [--plan ...]
                [--cadence monthly|biweekly|quarterly|semiannual|annual|term|usage|topup|other]
                [--start YYYY-MM-DD --end YYYY-MM-DD] [--month 3] [--kind fixed|approx|usage|unknown]
                [--account EMAIL] [--card 1234] [--url https://...] [--note ...] [--check ...]
  recurring charge ID AMOUNT [--date YYYY-MM-DD] [--note ...] [--keep-amount] [--force]
                                  record a real charge (refund = negative amount)
  recurring closing ID [--note ...]          you've started cancelling it (still billing, still counted)
  recurring cancel ID [--ends YYYY-MM-DD]   mark cancelled (optionally still running until --ends)
  recurring reactivate ID
  recurring set ID field=value [field=value ...]   (empty value clears the field)
  recurring remove ID             delete the entry entirely
  recurring sync [--since YYYY-MM-DD] [--status] [--trigger] [--daemon]
                                  ingest invoices across all mailboxes (instant push + hourly)
  recurring vault <status|init|unlock|lock|list|add|secret|rotate|delete|sweep|scan|import-sentinel>
                                  Sentinel-grade encrypted API key vault (Admin key / Org key)
  recurring wm-cloud [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--cover] [--json]
  recurring reimburse <build|status|verify|approvals> [...]
                                  deterministic cloud/API receipt packet builder, 1:1 IT approval pairing & ZIP
  recurring path                  print the file location

Commands that change the file need the exact id (see `recurring list`). Every
write takes the same lock as the app, keeps fields this tool doesn't know about,
backs the previous file up to subscriptions.json.bak and lands atomically as 0600.
"""
from __future__ import annotations

import argparse
import calendar
import contextlib
import fcntl
import json
import math
import os
import re
import sys
import uuid
from collections import defaultdict
from datetime import date, timedelta
from pathlib import Path

KINDS = ("fixed", "approx", "usage", "unknown")
CADENCES = ("biweekly", "monthly", "quarterly", "semiannual", "annual", "term", "usage", "topup", "other")
STATUSES = ("active", "cancelled", "unverified")
MONTHS = {"monthly": 1, "usage": 1, "quarterly": 3, "semiannual": 6, "annual": 12}
DAYS = {"biweekly": 14}
AVG_MONTH_DAYS = 30.436875          # 365.25 / 12, same constant as Model.swift
MAX_AMOUNT = 10_000_000.0           # Raw.maxAmount in Model.swift: bigger is a typo, not a bill
REFUND_STATUSES = ("open", "requested", "won", "lost")
WATCH_DAYS = 60                     # Insights.watchDays
WATCH_GRACE_DAYS = 3                # Insights.watchGraceDays
BIG_RENEWAL = 50.0                  # Insights.bigRenewal
DATE_FIELDS = ("cancelled_on", "ends_on", "last_charged", "next_renewal", "term_start", "term_end", "cancel_requested")
INT_FIELDS = {"billing_day": (1, 31), "billing_month": (1, 12)}
FLOAT_FIELDS = {"amount"}
STR_FIELDS = {"name", "category", "plan", "account", "card", "note", "check", "manage_url",
              "amount_kind", "cadence", "status", "group"} | set(DATE_FIELDS)
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


# ── file ──────────────────────────────────────────────────────────────────────

def ledger_path() -> Path:
    p = os.environ.get("RECURRING_FILE")
    if p:
        return Path(p).expanduser()
    return Path.home() / ".recurring" / "subscriptions.json"


def canonical_path() -> Path:
    """The real file behind ledger_path() (symlinks resolved), like
    LedgerFile.canonical in the app: lock, backup and write all derive from it."""
    return ledger_path().resolve()


# Read the file the way the app's JSONSerialization does, so both see the same
# data: a UTF-8 BOM is fine, the FIRST of two duplicate keys wins, and NaN,
# Infinity, 1e999 or a number too big for a double make the whole file invalid.
def _reject_constant(name):
    raise ValueError(f"non-standard JSON value {name}")


def _finite_float(s: str) -> float:
    f = float(s)
    if not math.isfinite(f):
        raise ValueError(f"number out of range: {s[:20]}")
    return f


def _bounded_int(s: str) -> int:
    if not math.isfinite(float(s)):                 # float("9" * 400) is inf, not an error
        raise ValueError(f"number out of range: {s[:20]}…")
    return int(s)


def _first_key_wins(pairs):
    out = {}
    for k, v in pairs:
        out.setdefault(k, v)
    return out


def decode(text: str):
    """JSON text → Python objects with the app's parsing rules (raises ValueError)."""
    return json.loads(text.removeprefix("\ufeff"), parse_constant=_reject_constant, parse_float=_finite_float,
                      parse_int=_bounded_int, object_pairs_hook=_first_key_wins)


def encode(raw) -> str:
    """The file format, byte for byte what PyJSON.dumps in the app writes."""
    return json.dumps(raw, indent=2, sort_keys=True, allow_nan=False) + "\n"


def load_raw() -> dict:
    """The file exactly as stored (unknown fields kept)."""
    path = canonical_path()
    if not path.exists():
        return {"version": 2, "currency": "USD", "services": []}
    try:
        raw = decode(path.read_text(encoding="utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        sys.exit(f"{path} isn't valid JSON ({e}); fix it first")
    if not isinstance(raw, dict):
        sys.exit(f"{path}: top level must be a JSON object")
    return raw


@contextlib.contextmanager
def locked():
    """Exclusive lock shared with the app (Model.swift LedgerFile.withLock)."""
    path = canonical_path()
    _private_dir(path.parent)
    fd = os.open(path.parent / f".{path.name}.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def _private_dir(d: Path) -> None:
    if not d.exists():
        d.mkdir(parents=True, mode=0o700)


def _write_securely(data: bytes, target: Path) -> None:
    """0600 temp file (O_EXCL), flushed to disk, renamed over `target`. Symlinks
    are not followed: the rename replaces a link with the file itself (same as
    LedgerFile.writeSecurely). Callers pass the canonical ledger path."""
    _private_dir(target.parent)
    tmp = target.parent / f".{target.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            try:
                fcntl.fcntl(f.fileno(), fcntl.F_FULLFSYNC)
            except (AttributeError, OSError):
                os.fsync(f.fileno())
        os.replace(tmp, target)
    except BaseException:
        if tmp.exists():
            tmp.unlink()
        raise
    dfd = os.open(target.parent, os.O_RDONLY)          # persist the rename itself
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)


def save(raw: dict) -> None:
    """Call only inside `locked()`. Backs up the current file, then replaces it."""
    path = canonical_path()
    data = encode(raw).encode()
    if path.exists():
        _write_securely(path.read_bytes(), path.with_name(path.name + ".bak"))
    _write_securely(data, path)


def today() -> date:
    override = os.environ.get("RECURRING_TODAY")  # tests pin the date
    if not override:
        return date.today()
    d = parse_day(override)
    if not d:
        sys.exit("RECURRING_TODAY must be YYYY-MM-DD")
    return d


def parse_day(s) -> date | None:
    """Strict yyyy-MM-dd on the first 10 characters (Model.swift Schedule.parseDay)."""
    if not isinstance(s, str) or len(s) < 10 or not DATE_RE.match(s[:10]):
        return None
    try:
        return date.fromisoformat(s[:10])
    except ValueError:
        return None


def num(v) -> float | None:
    """Finite JSON number, not a boolean (Model.swift Raw.number)."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    try:
        f = float(v)
    except OverflowError:
        return None
    return f if math.isfinite(f) else None


def intval(v) -> int | None:
    n = num(v)
    return int(n) if n is not None and n == int(n) and abs(n) < 1e9 else None


# ── normalization (mirror of Service.init(raw:) / Ledger.init(raw:)) ─────────

def _s(o: dict, k: str) -> str | None:
    v = o.get(k)
    return v if isinstance(v, str) and v else None


def normalize_service(o: dict, index: int, issues: list[str]) -> dict:
    label = _s(o, "id") or _s(o, "name") or f"service #{index + 1}"

    def flag(k, why):
        issues.append(f"{label}: {k} {why}")

    present = lambda k: k in o and o[k] is not None
    s: dict = {"_raw": o}
    s["name"] = _s(o, "name")
    if s["name"] is None:
        s["name"] = "(unnamed)"
        flag("name", "is missing")
    s["id"] = _s(o, "id") or s["name"].lower()
    s["category"] = _s(o, "category") or "Other"
    s["plan"] = _s(o, "plan")
    amt = num(o.get("amount"))
    if amt is not None and amt < 0:
        s["amount"] = None
        flag("amount", "is negative — record refunds as negative charges instead")
    elif amt is not None and amt > MAX_AMOUNT:
        s["amount"] = None
        flag("amount", "is out of range")
    else:
        s["amount"] = amt
        if present("amount") and amt is None:
            flag("amount", "is not a finite number")
    if isinstance(o.get("cadence"), str) and o["cadence"] in CADENCES:
        s["cadence"] = o["cadence"]
    elif "cadence" not in o:
        s["cadence"] = "monthly"
    else:
        s["cadence"] = "other"
        flag("cadence", "is not one of " + "/".join(CADENCES))
    if isinstance(o.get("status"), str) and o["status"] in STATUSES:
        s["status"] = o["status"]
    elif "status" not in o:
        s["status"] = "active"
    else:
        s["status"] = "unverified"
        flag("status", "is not active/cancelled/unverified — treated as unverified")
    kind = o.get("amount_kind")
    s["amount_kind"] = kind if isinstance(kind, str) and kind in KINDS else ("unknown" if s["amount"] is None else "fixed")
    for k, (lo, hi) in INT_FIELDS.items():
        v = intval(o.get(k))
        s[k] = v if v is not None and lo <= v <= hi else None
        if present(k) and s[k] is None:
            flag(k, f"must be {lo}–{hi}")
    for k in ("account", "card", "note", "check", "manage_url"):
        s[k] = _s(o, k)
    for k in DATE_FIELDS:
        if present(k) and parse_day(o.get(k)) is None:
            flag(k, "is not a yyyy-MM-dd date")
        s[k] = _s(o, k)
    kept = []
    if isinstance(o.get("charges"), list):
        for j, c in enumerate(o["charges"]):
            d = c.get("date") if isinstance(c, dict) else None
            a = num(c.get("amount")) if isinstance(c, dict) else None
            if parse_day(d) is None or a is None or abs(a) > MAX_AMOUNT:
                flag(f"charges[{j}]", "needs a yyyy-MM-dd date and a numeric amount — ignored")
                continue
            kept.append({"date": d[:10], "amount": a, "note": c.get("note") if isinstance(c.get("note"), str) else None})
    elif present("charges"):
        flag("charges", "is not a list — ignored")
    s["charges"] = kept
    s["group"] = _s(o, "group")
    claims = []
    if isinstance(o.get("refunds"), list):
        for j, c in enumerate(o["refunds"]):
            ok = isinstance(c, dict)
            a = num(c.get("amount")) if ok else None
            st = (c.get("status") if c.get("status") is not None else "open") if ok else None
            if a is None or not 0 < a <= MAX_AMOUNT or not isinstance(st, str) or st not in REFUND_STATUSES:
                flag(f"refunds[{j}]", "needs a positive amount and status open/requested/won/lost — ignored")
                continue
            claims.append({"amount": a, "status": st, "opened": c.get("opened") if isinstance(c.get("opened"), str) else None,
                           "resolved": c.get("resolved") if isinstance(c.get("resolved"), str) else None,
                           "note": c.get("note") if isinstance(c.get("note"), str) else None})
    elif present("refunds"):
        flag("refunds", "is not a list — ignored")
    s["refunds"] = claims
    return s


def normalize(raw: dict) -> tuple[list[dict], list[str]]:
    issues: list[str] = []
    services = []
    items = raw.get("services")
    if isinstance(items, list):
        for i, o in enumerate(items):
            if not isinstance(o, dict):
                issues.append(f"service #{i + 1}: is not a JSON object — ignored")
                continue
            services.append(normalize_service(o, i, issues))
    elif "services" in raw:
        issues.append("file: services is not a list")
    seen = set()
    for s in services:
        if s["id"] in seen:
            issues.append(f"{s['id']}: id is used more than once")
        seen.add(s["id"])
    return services, issues


# ── schedule (mirror of RecurringApp/Sources/Model.swift) ────────────────────

def clamped(year: int, month: int, day: int) -> date:
    year += (month - 1) // 12
    month = (month - 1) % 12 + 1
    return date(year, month, min(day, calendar.monthrange(year, month)[1]))


def add_months(d: date, n: int) -> date:
    return clamped(d.year, d.month + n, d.day)


def charge_dates(s: dict, ref: date, through: date, limit: int = 400) -> list[date]:
    if s["status"] != "active":
        return []
    nr = parse_day(s.get("next_renewal"))
    eff_ref = nr if (nr and nr > ref) else ref
    if eff_ref > through:
        return []
    cad = s["cadence"]
    out: list[date] = []
    if cad in DAYS:
        anchor = parse_day(s["term_start"]) or parse_day(s["last_charged"]) or nr
        if not anchor:
            return []
        for k in range(2000):
            d = anchor + timedelta(days=DAYS[cad] * k)
            if d < eff_ref:
                continue
            if d > through or len(out) >= limit:
                break
            out.append(d)
        return out
    m = MONTHS.get(cad)
    if not m:
        return []
    if m == 1:
        day = s["billing_day"]
        if day is None:
            lc = nr or parse_day(s["last_charged"])
            day = lc.day if lc else None
        if not day:
            return []
        for k in range(limit + 1):
            d = clamped(eff_ref.year, eff_ref.month + k, day)
            if d < eff_ref:
                continue
            if d > through:
                break
            out.append(d)
        return out
    anchor = parse_day(s["term_start"]) or parse_day(s["last_charged"]) or nr
    if anchor is None and s["billing_month"] and s["billing_day"]:
        anchor = clamped(eff_ref.year - 1, s["billing_month"], s["billing_day"])
    if anchor is None:
        return []
    for k in range(2000):
        d = add_months(anchor, k * m)
        if d < eff_ref:
            continue
        if d > through or len(out) >= limit:
            break
        out.append(d)
    return out


def next_charge(s: dict, ref: date) -> date | None:
    got = charge_dates(s, ref, ref + timedelta(days=3700), limit=1)
    return got[0] if got else None


def term_running(s: dict, ref: date) -> bool:
    a, b = parse_day(s["term_start"]), parse_day(s["term_end"])
    return s["cadence"] == "term" and s["status"] == "active" and bool(a and b and a <= ref <= b)


def monthly_equivalent(s: dict, ref: date) -> float | None:
    amt = s["amount"]
    if amt is None or s["status"] != "active":
        return None
    cad = s["cadence"]
    if cad == "term":
        if not term_running(s, ref):
            return None
        days = (parse_day(s["term_end"]) - parse_day(s["term_start"])).days
        return amt / (days / AVG_MONTH_DAYS) if days > 0 else None
    if cad in DAYS:
        return amt * 365.25 / DAYS[cad] / 12
    m = MONTHS.get(cad)
    return amt / m if m else None


def is_ending(s: dict, ref: date) -> bool:
    e = parse_day(s["ends_on"])
    return s["status"] == "cancelled" and bool(e and e >= ref)


def is_closing(s: dict) -> bool:
    return s["status"] == "active" and bool(s["cancel_requested"])


def events(services: list[dict], ref: date, days: int) -> list[tuple[date, str, dict]]:
    horizon = ref + timedelta(days=days)
    out = []
    for s in services:
        out += [(d, "charge", s) for d in charge_dates(s, ref, horizon)]
        if term_running(s, ref) and parse_day(s["term_end"]) <= horizon:
            out.append((parse_day(s["term_end"]), "expiry", s))
        if is_ending(s, ref) and parse_day(s["ends_on"]) <= horizon:
            out.append((parse_day(s["ends_on"]), "ending", s))
    return sorted(out, key=lambda t: (t[0], t[2]["name"]))


def cash_flow(services: list[dict], ref: date, back: int, ahead: int) -> dict[str, dict[str, float]]:
    """{month: {"charged": x, "scheduled": y}} — mirror of CashFlow.buckets."""
    first = clamped(ref.year, ref.month - back, 1)
    end = clamped(ref.year, ref.month + ahead + 1, 1) - timedelta(days=1)
    out: dict[str, dict[str, float]] = defaultdict(lambda: {"charged": 0.0, "scheduled": 0.0})
    for s in services:
        dated = {c["date"] for c in s["charges"]}
        for c in s["charges"]:
            d = parse_day(c["date"])
            if first <= d <= ref:
                out[d.strftime("%Y-%m")]["charged"] += c["amount"]
        if s["amount"] is None:
            continue
        for d in charge_dates(s, ref, end):
            if d == ref and ref.isoformat() in dated:
                continue
            out[d.strftime("%Y-%m")]["scheduled"] += s["amount"]
    return {k: {kk: round(vv, 2) for kk, vv in v.items()} for k, v in sorted(out.items())}


def monthly_total(services: list[dict], ref: date) -> float:
    return sum(v for s in services if (v := monthly_equivalent(s, ref)) is not None)


# ── insights (mirror of Insights in Model.swift) ──────────────────────────────

def r2(v: float) -> float:
    """Round half away from zero to cents, like Swift's (v * 100).rounded() / 100."""
    return math.copysign(math.floor(abs(v) * 100 + 0.5), v) / 100


def renewals(services: list[dict], ref: date, days: int) -> list[dict]:
    out = []
    for d, kind, s in events(services, ref, days):
        if kind != "charge":
            continue
        left = (d - ref).days
        out.append({"service": s, "date": d, "days_left": left,
                    "cancel_by": d - timedelta(days=1) if left >= 1 else None, "amount": s["amount"]})
    return out


def as_active(s: dict) -> dict:
    return {**s, "status": "active", "cancel_requested": None}


def effective_end(s: dict) -> date | None:
    c = parse_day(s["cancelled_on"])
    if not c:
        return None
    after = c + timedelta(days=1)
    e = parse_day(s["ends_on"])
    return max(e, after) if e else after


def late_charges(s: dict) -> list[dict]:
    end = effective_end(s)
    if not end:
        return []
    return [c for c in s["charges"] if c["amount"] > 0 and parse_day(c["date"]) >= end]


def watch(services: list[dict], ref: date) -> list[dict]:
    items = []
    for s in services:
        if s["status"] != "cancelled":
            continue
        cancelled, end = parse_day(s["cancelled_on"]), effective_end(s)
        if not cancelled or not end:
            continue
        late = late_charges(s)
        if (ref - cancelled).days > WATCH_DAYS and not late:
            continue
        would = next_charge(as_active(s), end)
        if would is None and not late:
            continue
        if late:
            status = "charged_after_cancel"
        elif would and (would - ref).days >= -WATCH_GRACE_DAYS:
            status = "watch"
        else:
            status = "clear"
        items.append({"service": s, "would_charge": would, "status": status, "late": late,
                      "late_total": sum(c["amount"] for c in late)})
    rank = {"charged_after_cancel": 0, "watch": 1, "clear": 2}
    return sorted(items, key=lambda w: (rank[w["status"]], w["would_charge"] or date.max, w["service"]["name"]))


def savings(services: list[dict], ref: date, since_days: int = 30) -> dict:
    since = ref - timedelta(days=since_days)
    items = []
    for s in services:
        if s["status"] != "cancelled":
            continue
        c, end = parse_day(s["cancelled_on"]), effective_end(s)
        if not c or not end or not since <= c <= ref:
            continue
        a = as_active(s)
        m = monthly_equivalent(a, c)
        if not m or m <= 0:
            continue
        avoided = len(charge_dates(a, end, ref)) if end <= ref else 0
        kept = max(0.0, (s["amount"] or 0) * avoided - sum(x["amount"] for x in late_charges(s)))
        items.append({"service": s, "on": c, "monthly": r2(m), "kept": r2(kept)})
    items.sort(key=lambda i: (-i["monthly"], i["service"]["name"]))
    closing = sum(v for s in services if is_closing(s) and (v := monthly_equivalent(s, ref)) is not None)
    return {"since": since, "items": items, "monthly": r2(sum(i["monthly"] for i in items)),
            "kept": r2(sum(i["kept"] for i in items)), "closing": r2(closing)}


def cuts_by_month(services: list[dict], ref: date, months: int = 6) -> list[tuple[str, float]]:
    first = clamped(ref.year, ref.month - (months - 1), 1)
    sums: dict[str, float] = defaultdict(float)
    for s in services:
        if s["status"] != "cancelled":
            continue
        c = parse_day(s["cancelled_on"])
        if not c or not first <= c <= ref:
            continue
        m = monthly_equivalent(as_active(s), c)
        if m and m > 0:
            sums[c.strftime("%Y-%m")] += m
    return [(k, r2(sums.get(k, 0.0))) for k in (add_months(first, i).strftime("%Y-%m") for i in range(months))]


def base_name(name: str) -> str:
    s = name.lower()
    s = re.sub(r"\([^)]*\)", " ", s)
    s = re.sub(r"\$[0-9.,]+", " ", s)
    if " — " in s:
        s = s.split(" — ")[0]
    s = re.sub("[\"“”']", "", s)
    s = re.sub(r"\s+", " ", s)
    return s.strip()


def cut_groups(services: list[dict], ref: date) -> list[dict]:
    buckets: dict[str, dict] = {}
    for s in services:
        if s["status"] != "active" or is_closing(s):
            continue
        m = monthly_equivalent(s, ref)
        if not m or m <= 0:
            continue
        key = "group:" + s["group"].lower() if s["group"] else "same:" + base_name(s["name"])
        b = buckets.setdefault(key, {"name": s["group"] or s["name"], "auto": s["group"] is None, "members": []})
        b["members"].append(s)
    out = []
    for b in buckets.values():
        if len(b["members"]) < 2:
            continue
        costs = {id(s): monthly_equivalent(s, ref) for s in b["members"]}
        members = sorted(b["members"], key=lambda s: (-costs[id(s)], s["name"]))
        total = sum(costs.values())
        name = min((s["name"] for s in b["members"]), key=lambda n: (len(n), n)) if b["auto"] else b["name"]
        out.append({"name": name, "auto": b["auto"], "members": members, "monthly": r2(total),
                    "save_min": r2(total - max(costs.values())), "save_max": r2(total - min(costs.values()))})
    return sorted(out, key=lambda g: (-g["monthly"], g["name"]))


def refund_claims(services: list[dict]) -> list[tuple[dict, dict]]:
    pending = lambda c: c["status"] in ("open", "requested")
    pairs = [(s, c) for s in services for c in s["refunds"]]
    return sorted(pairs, key=lambda p: (0 if pending(p[1]) else 1, p[1]["opened"] or "", p[0]["name"]))


def pending_refund_total(services: list[dict]) -> float:
    return r2(sum(c["amount"] for _, c in refund_claims(services) if c["status"] in ("open", "requested")))


def burn_breakdown(services: list[dict], ref: date) -> dict:
    """Single-pass structural burn breakdown, mirrored by Insights.burnBreakdown in Model.swift."""
    r2 = lambda v: round(v, 2)
    priced: list[tuple[dict, float]] = []
    fixed_mo = usage_mo = multi_mo = term_mo = 0.0
    unmapped_cards = 0
    cat_acc: dict[str, list] = defaultdict(lambda: [0.0, 0])
    acct_acc: dict[str, list] = defaultdict(lambda: [0.0, 0])
    card_acc: dict[str, list] = defaultdict(lambda: [0.0, 0])

    for s in services:
        if s["status"] != "active":
            continue
        if s["amount"] is not None and not s.get("card"):
            unmapped_cards += 1
        m = monthly_equivalent(s, ref)
        if m is None:
            continue
        priced.append((s, m))
        cad = s["cadence"]
        if cad == "usage":
            usage_mo += m
        elif cad == "term":
            term_mo += m
        elif cad in ("quarterly", "semiannual", "annual"):
            multi_mo += m
        else:
            fixed_mo += m

        cat_acc[s["category"]][0] += m
        cat_acc[s["category"]][1] += 1

        acct_key = s.get("account") or "unknown"
        acct_acc[acct_key][0] += m
        acct_acc[acct_key][1] += 1

        raw_card = s.get("card") or "unknown"
        card_acc[raw_card][0] += m
        card_acc[raw_card][1] += 1

    priced.sort(key=lambda sm: (-sm[1], sm[0]["name"]))
    total = sum(m for _, m in priced)
    denom = max(total, 0.0001)

    def _slices(acc: dict[str, list], card_fmt: bool = False) -> list[dict]:
        rows = []
        for k, (val, cnt) in acc.items():
            lbl = f"card ···· {k}" if (card_fmt and k != "unknown" and k.isdigit()) else k
            rows.append({
                "key": k,
                "label": lbl,
                "monthly": r2(val),
                "count": cnt,
                "share": val / denom if total > 0 else 0.0,
            })
        return sorted(rows, key=lambda x: (-x["monthly"], x["key"]))

    asc = sorted(m for _, m in priced)
    if not asc:
        median = 0.0
    elif len(asc) % 2 == 1:
        median = asc[len(asc) // 2]
    else:
        median = (asc[len(asc) // 2 - 1] + asc[len(asc) // 2]) / 2.0

    under10 = [m for _, m in priced if m < 10]
    return {
        "total_monthly": r2(total),
        "fixed_monthly": r2(fixed_mo),
        "usage_monthly": r2(usage_mo),
        "multi_month_monthly": r2(multi_mo),
        "prepaid_term_monthly": r2(term_mo),
        "by_category": _slices(cat_acc),
        "by_account": _slices(acct_acc),
        "by_card": _slices(card_acc, card_fmt=True),
        "unmapped_card_count": unmapped_cards,
        "median_monthly": r2(median),
        "average_monthly": r2(total / len(priced)) if priced else 0.0,
        "top5_share": sum(m for _, m in priced[:5]) / denom if total > 0 else 0.0,
        "top10_share": sum(m for _, m in priced[:10]) / denom if total > 0 else 0.0,
        "under10_count": len(under10),
        "under10_monthly": r2(sum(under10)),
    }


# ── helpers ───────────────────────────────────────────────────────────────────

def active(services: list[dict]) -> list[dict]:
    return [s for s in services if s["status"] == "active"]


def money(v: float | None, kind: str = "fixed") -> str:
    if v is None:
        return "—"
    return ("~" if kind == "approx" else "") + f"${v:,.2f}"


def find_exact(services: list[dict], ident: str) -> dict:
    """Changes need the exact id — a fuzzy match could hit the wrong service."""
    hits = [s for s in services if s["id"] == ident]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        sys.exit(f"id '{ident}' is used by {len(hits)} services; fix the duplicate first")
    near = [s["id"] for s in services if ident.lower() in s["id"].lower() or ident.lower() in s["name"].lower()]
    sys.exit(f"no service with id '{ident}'" + (f" — did you mean: {', '.join(near)}?" if near else ""))


def slug(name: str, taken: set[str]) -> str:
    base = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "service"
    out, n = base, 2
    while out in taken:
        out, n = f"{base}-{n}", n + 1
    return out


def schedule_label(s: dict) -> str:
    c = s["cadence"]
    if c == "monthly":
        return f"day {s['billing_day']}" if s["billing_day"] else "monthly"
    if c == "term":
        return f"until {s['term_end'] or '?'}"
    return {"biweekly": "2-weekly", "quarterly": "quarterly", "semiannual": "6-monthly", "annual": "yearly",
            "usage": "usage", "topup": "top-up"}.get(c, "")


def check_date(v: str, flag: str) -> str:
    if not parse_day(v) or len(v) != 10:
        sys.exit(f"{flag} must be YYYY-MM-DD")
    return v


def finite_float(v: str) -> float:
    try:
        f = float(v)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {v}")
    if not math.isfinite(f) or abs(f) > MAX_AMOUNT:
        raise argparse.ArgumentTypeError(f"amount must be a number between -{MAX_AMOUNT:,.0f} and {MAX_AMOUNT:,.0f}")
    return f


def day_of_month(v: str) -> int:
    d = int(v)
    if not 1 <= d <= 31:
        raise argparse.ArgumentTypeError("must be 1-31")
    return d


def month_of_year(v: str) -> int:
    m = int(v)
    if not 1 <= m <= 12:
        raise argparse.ArgumentTypeError("must be 1-12")
    return m


